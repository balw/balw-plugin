{
	"name": "balw/balw-plugin",
	"description": "A base setup for WordPress plugins",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"version": "0.0.1",
	"autoload": {
		"psr-4": {
			"Balw\\BalwPlugin\\": "inc/"
		}
	},
	"authors": [
		{
			"name": "Ben Wells",
			"email": "ben@balw.co.uk"
		}
	],
	"minimum-stability": "stable",
	"prefer-stable": true,
	"config": {
		"platform": {
			"php": "8.3.0"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"automattic/vipwpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"johnbillion/wp-compat": "^2.0.1",
		"php-stubs/wordpress-stubs": "7.0.*",
		"phpcompatibility/php-compatibility": "10.0.0-alpha2",
		"phpcompatibility/phpcompatibility-paragonie": "2.0.0-alpha2",
		"phpcompatibility/phpcompatibility-wp": "3.0.0-alpha2",
		"phpunit/phpunit": "^9.6",
		"phpstan/phpstan": "^2.1.55",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.0",
		"squizlabs/php_codesniffer": "^3.13.5",
		"szepeviktor/phpstan-wordpress": "^2.0.4",
		"wp-phpunit/wp-phpunit": "7.0.*",
		"yoast/phpunit-polyfills": "^1.1",
		"wp-coding-standards/wpcs": "^3.4.1"
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"phpstan": "phpstan analyse --memory-limit=512M",
		"test:unit": "phpunit -c phpunit.unit.xml.dist",
		"check": [
			"@lint",
			"@phpstan",
			"@test:unit"
		]
	}
}
