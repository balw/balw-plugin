{
	"name": "balw-plugin",
	"version": "0.0.1",
	"description": "A base setup for WordPress plugins",
	"license": "GPL-2.0-or-later",
	"author": "Ben Wells",
	"engines": {
		"node": "^24.15.0"
	},
	"scripts": {
		"start": "wp-scripts start --blocks-manifest",
		"typecheck": "tsc --noEmit",
		"typecheck:watch": "tsc --noEmit --watch",
		"typecheck:tests": "tsc --project tsconfig.vitest.json --noEmit",
		"build": "npm run typecheck && wp-scripts build --blocks-manifest",
		"lint:js": "wp-scripts lint-js src --max-warnings=0",
		"lint:tests": "wp-scripts lint-js 'src/**/tests/**/*.test.ts' vitest.config.mts --max-warnings=0",
		"lint:css": "wp-scripts lint-style 'src/**/*.scss' --max-warnings=0",
		"lint:e2e": "wp-scripts lint-js 'tests/e2e/**/*.ts' playwright.config.ts --max-warnings=0",
		"format": "wp-scripts format src tests/e2e playwright.config.ts vitest.config.mts tsconfig.json tsconfig.vitest.json",
		"check": "npm run lint:js && npm run lint:tests && npm run lint:e2e && npm run lint:css && npm run typecheck:tests && npm run typecheck:e2e && npm run test:js && npm run build",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"test:unit": "composer test:unit",
		"test:js": "wp-scripts test-unit-js",
		"test:js:watch": "wp-scripts test-unit-js --watch",
		"test:integration": "wp-env run cli --env-cwd=wp-content/plugins/balw-plugin vendor/bin/phpunit -c phpunit.integration.xml.dist",
		"test:e2e": "wp-scripts test-playwright",
		"test:e2e:ui": "npm run test:e2e -- --ui",
		"typecheck:e2e": "tsc --project tests/e2e/tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@types/node": "^24.19.1",
		"@types/react": "18.3.31",
		"@types/wordpress__block-editor": "15.0.6",
		"@types/wordpress__blocks": "15.10.2",
		"@wordpress/block-editor": "15.13.2",
		"@wordpress/blocks": "15.13.1",
		"@wordpress/e2e-test-utils-playwright": "^2.1.0",
		"@wordpress/env": "^11.16.0",
		"@wordpress/i18n": "6.13.1",
		"@wordpress/scripts": "^36.0.0",
		"typescript": "~6.0.3",
		"vite": "^8.0.0",
		"vitest": "^5.0.0"
	},
	"prettier": "@wordpress/prettier-config"
}
